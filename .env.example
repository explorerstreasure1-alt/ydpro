GROQ_API_KEY=your_groq_api_key_here
# Örn: GROQ_API_KEY=gsk_xxx  -> https://console.groq.com/keys
# DATABASE_URL opsiyonel — yoksa demo modda çalışır (localStorage)
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# ElevenLabs stüdyo sesi (opsiyonel — Vercel env'e ekle, yoksa tarayıcı sesi)
# ELEVENLABS_API_KEY=sk_xxx  -> https://elevenlabs.io/app/settings/api-keys
# Opsiyonel sesler: ELEVENLABS_VOICE_ID (genel), ELEVENLABS_VOICE_TR (dil bazlı)
# Stüdyo kilit + uygulama giriş şifresi (Vercel env'e ekle — koda ASLA yazılmaz):
# ELEVENLABS_TTS_PASSWORD=buraya-sifren
